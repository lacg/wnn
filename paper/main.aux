\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces RAM neuron architecture with two neurons ($N{=}2$, $n{=}3$ address bits each). Each neuron selects 3 bits from the 9-bit input via its connectivity map, forms a 3-bit address, and looks up its quad-weighted memory ($2^3{=}8$ cells). Cell colors: \textcolor {green!60!black}{TRUE (1.0)}, \textcolor {blue!60}{WEAK\_TRUE (0.75)}, \textcolor {gray}{WEAK\_FALSE (0.25)}, \textcolor {red!70}{FALSE (0.0)}. The mean score is thresholded to classify the input.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:ram-neuron}{{1}{3}{RAM neuron architecture with two neurons ($N{=}2$, $n{=}3$ address bits each). Each neuron selects 3 bits from the 9-bit input via its connectivity map, forms a 3-bit address, and looks up its quad-weighted memory ($2^3{=}8$ cells). Cell colors: \textcolor {green!60!black}{TRUE (1.0)}, \textcolor {blue!60}{WEAK\_TRUE (0.75)}, \textcolor {gray}{WEAK\_FALSE (0.25)}, \textcolor {red!70}{FALSE (0.0)}. The mean score is thresholded to classify the input}{figure.1}{}}
