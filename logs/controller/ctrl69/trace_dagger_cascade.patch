+/// CTRL-69 DIAGNOSTIC (scratch, not shipped): the DAgger rollout exactly as `cfg`
+/// says (expert_drives decides who flies), returning per decision record the
+/// feature vector, the recorded label and its delta baseline, and per PHYSICAL step
+/// the flown rate loop's [err ×3, I/i_limit ×3, decision, phase, episode].
+pub fn trace_dagger_cascade_rs(
+	controller: &mut WnnController,
+	cfg: &RewardGatedConfigPacked,
+	num_episodes: usize,
+	seed: u64,
+	shadow_resid_plant: Option<[f64; 5]>,
+) -> (Vec<Vec<f32>>, Vec<[f32; 4]>, Vec<[f32; 4]>, Vec<[f32; 9]>, Vec<[f32; 3]>)
+{
+	let mut rng = SmallRng::seed_from_u64(seed);
+	let af = AirframeRs::from_cfg(cfg);
+	let mut bank = TeacherBank::new(af);
+	let mut sim = af.sim();
+	controller.set_observer_motor_lag_core(sim.motor_lag());
+	let tilt = cfg.full_tilt_deg.to_radians();
+	let mut cap = ImitCapture::new(false, false);
+	if let Some(p) = shadow_resid_plant
+	{
+		let mut spec = controller.ctbr_ref().expect("shadow residual needs a CTBR controller").spec.clone();
+		spec.obs_rate_i = false;
+		spec.obs_dhat_plant = None;
+		spec.obs_dhat_residual_plant = Some(p);
+		cap.shadow = spec.cascade_obs(controller.dt_core());
+		cap.shadow_lag_s = sim.motor_lag();
+	}
+	for ep in 0..num_episodes
+	{
+		let teacher = bank.get_mut(cfg.teacher_id_for(0, ep));
+		let _ = rollout_and_label_inner(controller, teacher, &mut sim, cfg, tilt, &mut rng, [0.0; 3], Some(&mut cap));
+	}
+	(cap.feats, cap.label, cap.label_base, cap.phys, cap.shadow_resid)
+}
