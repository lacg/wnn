+	halves, until the budget (None = unbounded) is spent or no segment has positive gain."""
 	heap, cuts = [], {name: [] for name in tables}
 	for name, (u, c) in tables.items():
 		_push(heap, name, c, 0, len(u))
 	placed = 0
